{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run DamageMap API",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\uvicorn.exe",
			"args": [
				"ml.api:app",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run DamageMap Web",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"web",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}